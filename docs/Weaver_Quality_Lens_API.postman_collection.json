{
  "info": {
    "name": "Weaver Quality Lens API",
    "description": "Complete API collection for Weaver Quality Lens - Analytics for Azure DevOps Test Plans, Bug Metrics, and SonarQube Integration",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            },
            "description": "Check the health status of the API server and connected services"
          }
        }
      ]
    },
    {
      "name": "Organization",
      "item": [
        {
          "name": "Get Area Paths",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/organization/areaPaths",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "organization", "areaPaths"]
            },
            "description": "Get all available area paths from Azure DevOps organization"
          }
        }
      ]
    },
    {
      "name": "Test Plans",
      "item": [
        {
          "name": "Get Test Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/testplans?areaPaths=Kantar Automation Platform\\Core",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "testplans"],
              "query": [
                {
                  "key": "areaPaths",
                  "value": "Kantar Automation Platform\\Core",
                  "description": "Comma-separated list of area paths"
                }
              ]
            },
            "description": "Get test plans for specified area paths"
          }
        },
        {
          "name": "Get Automation Metrics",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": 12345,\n    \"name\": \"Sprint 15 - Core Team Tests\"\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/testplans/automation-metrics?startDate=2024-01-01&endDate=2024-01-31",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "testplans", "automation-metrics"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2024-01-01",
                  "description": "Start date for new automation tracking"
                },
                {
                  "key": "endDate",
                  "value": "2024-01-31",
                  "description": "End date for new automation tracking"
                }
              ]
            },
            "description": "Calculate automation metrics for test plans"
          }
        },
        {
          "name": "Track New Automations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plans\": [\n    {\n      \"id\": 12345,\n      \"name\": \"Sprint 15 Tests\"\n    }\n  ],\n  \"startDate\": \"2024-01-01\",\n  \"endDate\": \"2024-01-31\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/testplans/new-automations",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "testplans", "new-automations"]
            },
            "description": "Track test cases that were automated within a date range"
          }
        },
        {
          "name": "Get Suite Coverage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plans\": [\n    {\n      \"id\": 12345,\n      \"name\": \"Sprint 15 Tests\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/testplans/suites/coverage",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "testplans", "suites", "coverage"]
            },
            "description": "Get automation coverage per test suite"
          }
        }
      ]
    },
    {
      "name": "Test Cases",
      "item": [
        {
          "name": "Get Ready Test Cases",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/testcases?areaPaths=Kantar Automation Platform\\Core",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "testcases"],
              "query": [
                {
                  "key": "areaPaths",
                  "value": "Kantar Automation Platform\\Core",
                  "description": "Comma-separated list of area paths"
                }
              ]
            },
            "description": "Get test cases that are ready for execution"
          }
        },
        {
          "name": "Analyze Test Case Usage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"testCases\": [\n    {\n      \"id\": 12345,\n      \"title\": \"Login functionality test\"\n    },\n    {\n      \"id\": 12346,\n      \"title\": \"Dashboard loading test\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/testcases/usage",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "testcases", "usage"]
            },
            "description": "Analyze which test cases have been used in recent test runs"
          }
        }
      ]
    },
    {
      "name": "Teams - Bug Metrics",
      "item": [
        {
          "name": "Get Bugs by Sprint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/teams/bugs-by-sprint?areaPaths=Kantar Automation Platform\\Core&numSprints=5",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "teams", "bugs-by-sprint"],
              "query": [
                {
                  "key": "areaPaths",
                  "value": "Kantar Automation Platform\\Core",
                  "description": "Comma-separated list of area paths"
                },
                {
                  "key": "numSprints",
                  "value": "5",
                  "description": "Number of past sprints to analyze"
                }
              ]
            },
            "description": "Get bug metrics by sprints for teams"
          }
        },
        {
          "name": "Get Bug Details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"links\": [\n    \"https://dev.azure.com/org/project/_workitems/edit/12345\",\n    \"https://dev.azure.com/org/project/_workitems/edit/12346\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/teams/bug-details",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "teams", "bug-details"]
            },
            "description": "Get detailed information about specific bugs"
          }
        },
        {
          "name": "Analyze Bug Leakage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"areaPaths\": [\n    \"Kantar Automation Platform\\\\Core\",\n    \"Kantar Automation Platform\\\\Testing\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/teams/bug-leakage",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "teams", "bug-leakage"]
            },
            "description": "Analyze bug leakage patterns across environments"
          }
        },
        {
          "name": "Get Bug Leakage by Sprint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/teams/bug-leakage-sprint?areaPaths=Kantar Automation Platform\\Core&numSprints=5",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "teams", "bug-leakage-sprint"],
              "query": [
                {
                  "key": "areaPaths",
                  "value": "Kantar Automation Platform\\Core",
                  "description": "Comma-separated list of area paths"
                },
                {
                  "key": "numSprints",
                  "value": "5",
                  "description": "Number of recent sprints to analyze"
                }
              ]
            },
            "description": "Get bug leakage analysis per sprint"
          }
        }
      ]
    },
    {
      "name": "Teams - Automation Metrics",
      "item": [
        {
          "name": "Get Sprint Automation Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/teams/sprints/automation-metrics?areaPaths=Kantar Automation Platform\\Core&numSprints=5",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "teams", "sprints", "automation-metrics"],
              "query": [
                {
                  "key": "areaPaths",
                  "value": "Kantar Automation Platform\\Core",
                  "description": "Comma-separated list of area paths"
                },
                {
                  "key": "numSprints",
                  "value": "5",
                  "description": "Number of sprints to analyze"
                }
              ]
            },
            "description": "Get automation metrics aggregated by sprints"
          }
        }
      ]
    },
    {
      "name": "SonarQube",
      "item": [
        {
          "name": "Search Components",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/components/search?qualifiers=TRK,VW&page=1&size=50",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "components", "search"],
              "query": [
                {
                  "key": "qualifiers",
                  "value": "TRK,VW",
                  "description": "Component qualifiers (TRK, APP, VW, SWV)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "size",
                  "value": "50",
                  "description": "Results per page"
                }
              ]
            },
            "description": "Search for components in SonarQube"
          }
        },
        {
          "name": "Get Component Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/measures/component?componentKey=my-project:main",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "measures", "component"],
              "query": [
                {
                  "key": "componentKey",
                  "value": "my-project:main",
                  "description": "SonarQube component key"
                }
              ]
            },
            "description": "Get quality metrics for a SonarQube component"
          }
        }
      ]
    }
  ]
}